{
  "type": "record",
  "name": "LogEmittedEvent",
  "namespace": "com.livescope.events",
  "fields": [
    { "name": "id", "type": "string" },
    { "name": "type", "type": "string" },
    { "name": "entity", "type": "string" },
    { "name": "entityId", "type": "string" },
    { "name": "timestamp", "type": "long" },
    { "name": "vectorClock", "type": { "type": "map", "values": "long" } },
    { "name": "orgId", "type": "string", "default": "local" },
    { "name": "projectId", "type": "string", "default": "default" },
    { "name": "environment", "type": "string", "default": "dev" },
    { "name": "region", "type": "string", "default": "local" },
    {
      "name": "payload",
      "type": {
        "type": "record",
        "name": "LogPayload",
        "fields": [
          { "name": "level", "type": "string" },
          { "name": "message", "type": "string" },
          { "name": "context", "type": { "type": "map", "values": "string" }, "default": {} }
        ]
      }
    }
  ]
}
